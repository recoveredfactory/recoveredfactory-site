{
  "name": "recoveredfactory-ghost",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.7.0",
  "scripts": {
    "dev": "pnpm -C apps/web dev",
    "dev:sst": "sst dev",
    "build": "pnpm -r build",
    "build:web": "pnpm -C apps/web build",
    "lint": "pnpm -C apps/web lint",
    "format": "pnpm -C apps/web format",
    "deploy": "sst deploy",
    "backup:assets": "./scripts/backup-assets.sh",
    "daybook": "node apps/web/scripts/daybook/pull.mjs",
    "daybook:again": "node apps/web/scripts/daybook/pull.mjs --offline",
    "daybook:ship": "PUBLIC_DAYBOOK_BANNER=1 sst deploy --stage prod && ./scripts/backup-assets.sh"
  },
  "devDependencies": {
    "sst": "^3.0.0",
    "@inlang/paraglide-js": "^2.8.0"
  }
}
